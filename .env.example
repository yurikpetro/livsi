APP_NAME=LIVSI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Почта. Локально `log` — письмо пишется в storage/logs/laravel.log
# и никуда не уходит. На боевом контуре — smtp.
#
# Заказчик подключил Яндекс 360, поэтому отправка идёт через ящик на своём
# домене. Пароль здесь нужен не от аккаунта, а **пароль приложения**:
# он создаётся в настройках безопасности Яндекс ID, обычный пароль
# при включённой двухфакторной проверке SMTP не примет.
#
# Лимит Яндекса на отправку через SMTP — около 300 писем в сутки с ящика.
# Заказ порождает два письма покупателю и одно менеджеру, то есть потолок
# примерно сто заказов в день. Упрёмся — переходим на Яндекс Рассылки.
#
# MAIL_USERNAME — полный адрес ящика, а не логин: shop@livsi.shop.
# MAIL_FROM_ADDRESS должен совпадать с ним, иначе Яндекс подменит отправителя
# и подпись DKIM не сойдётся с адресом в письме.
# На боевом контуре MAIL_MAILER=smtp; log оставлен для локальной разработки.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Администратор Back Office (/admin).
# На локальной машине можно не задавать — сидер подставит admin@livsi.shop / livsi-admin.
# На боевом контуре обязательно: без них администратор не создаётся.
ADMIN_NAME="Администратор"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Уведомления о заявках. Основное место — настройка manager_email в базе;
# это значение работает, пока экрана настроек в админке нет.
# Адрес может быть алиасом на том же ящике — отдельный сотрудник в Яндекс 360
# тарифицируется, алиас бесплатен.
MANAGER_EMAIL=

# Картинки из админки грузятся на диск public_images (корень — public/),
# чтобы путь имел вид img/catalog/foo.jpg: его ждут и витрина, и конвейер
# `npm run images`. Диск задан явно у каждого поля загрузки, поэтому
# FILESYSTEM_DISK для приложения трогать не нужно.

# Оплата через ЮKassa. Ключи — из личного кабинета.
# У тестового магазина секретный ключ начинается с test_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Локальная проверка оплаты через туннель: адрес отправителя приходит
# в заголовке от прокси, а список сетей ЮKassa нужно расширить адресом туннеля.
# На боевом контуре TRUSTED_PROXIES — адреса балансировщика, не «*».
TRUSTED_PROXIES=
YOOKASSA_WEBHOOK_IPS=

# Вход через Яндекс ID. Приложение заводится на oauth.yandex.ru.
# Redirect URI там должен совпадать с маршрутом auth.yandex.callback посимвольно.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
