APP_NAME=LIVSI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# На боевом контуре: LOG_STACK=daily,telegram — файл остаётся источником
# правды, Телеграм лишь сообщает, что в него пора заглянуть.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_TELEGRAM_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Почта. Локально `log` — письмо пишется в storage/logs/laravel.log
# и никуда не уходит. На боевом контуре — smtp.
#
# Заказчик подключил Яндекс 360, поэтому отправка идёт через ящик на своём
# домене. Пароль здесь нужен не от аккаунта, а **пароль приложения**:
# он создаётся в настройках безопасности Яндекс ID, обычный пароль
# при включённой двухфакторной проверке SMTP не примет.
#
# Лимит Яндекса на отправку через SMTP — около 300 писем в сутки с ящика.
# Заказ порождает два письма покупателю и одно менеджеру, то есть потолок
# примерно сто заказов в день. Упрёмся — переходим на Яндекс Рассылки.
#
# MAIL_USERNAME — полный адрес ящика, а не логин: shop@livsi.shop.
# MAIL_FROM_ADDRESS должен совпадать с ним, иначе Яндекс подменит отправителя
# и подпись DKIM не сойдётся с адресом в письме.
# На боевом контуре MAIL_MAILER=smtp; log оставлен для локальной разработки.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Администратор Back Office (/admin).
# На локальной машине можно не задавать — сидер подставит admin@livsi.shop / livsi-admin.
# На боевом контуре обязательно: без них администратор не создаётся.
ADMIN_NAME="Администратор"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Уведомления о заявках. Основное место — настройка manager_email в базе;
# это значение работает, пока экрана настроек в админке нет.
# Адрес может быть алиасом на том же ящике — отдельный сотрудник в Яндекс 360
# тарифицируется, алиас бесплатен.
MANAGER_EMAIL=

# Картинки из админки грузятся на диск public_images (корень — public/),
# чтобы путь имел вид img/catalog/foo.jpg: его ждут и витрина, и конвейер
# `npm run images`. Диск задан явно у каждого поля загрузки, поэтому
# FILESYSTEM_DISK для приложения трогать не нужно.

# Оплата через ЮKassa. Ключи — из личного кабинета.
# У тестового магазина секретный ключ начинается с test_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Минимальное время удержания резерва неоплаченного заказа (по умолчанию 24 ч).
# Пока ЮKassa подтверждает pending, товар остаётся в резерве и после этого срока.
ORDER_RESERVE_MINUTES=1440

# Первый этап доставки: Россия, отгрузка с одной площадки в Ставрополе.
DELIVERY_COUNTRY_CODE=RU
DELIVERY_ORIGIN_CITY=Ставрополь

# Токен с главной страницы ApiShip. СДЭК и Яндекс включать после подключения в ЛК.
APISHIP_TOKEN=
# Необязательный исходящий IP сервера для соединений с ApiShip.
APISHIP_SOURCE_IP=
YANDEX_MAPS_API_KEY=
YANDEX_SUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
APISHIP_ACTIVE_PROVIDERS=ozonlog
# После подключения «Ozon Доставка для бизнеса» используйте ozondel вместо ozonlog.
APISHIP_OZON_CONNECTION_ID=

# Прямые службы: apiship или direct; ключи можно задать в админке.
DELIVERY_SOURCE_IP=
DELIVERY_CDEK=apiship
DELIVERY_YANDEX=apiship
DELIVERY_OZON=apiship
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_TEST=false
CDEK_API_URL=
CDEK_TARIFFS=136,368,234,378,483,486
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_TEST=false
YANDEX_DELIVERY_TEST_TOKEN=
YANDEX_DELIVERY_API_URL=
OZON_APP_CLIENT_ID=
OZON_APP_CLIENT_SECRET=
OZON_DELIVERY_API_URL=https://api-delivery.ozon.ru

# API сборки заказов для livsipro.ru. Пустой токен закрывает доступ.
LIVSIPRO_API_TOKEN=
LIVSIPRO_API_IPS=
LIVSIPRO_REQUIRE_MARKS=true
LIVSIPRO_SENDER_NAME=
LIVSIPRO_SENDER_PHONE=

# Локальная проверка оплаты через туннель: адрес отправителя приходит
# в заголовке от прокси, а список сетей ЮKassa нужно расширить адресом туннеля.
# На боевом контуре TRUSTED_PROXIES — адреса балансировщика, не «*».
TRUSTED_PROXIES=
YOOKASSA_WEBHOOK_IPS=

# Вход через Яндекс ID. Приложение заводится на oauth.yandex.ru.
# Redirect URI там должен совпадать с маршрутом auth.yandex.callback посимвольно.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK и Mail используют одно Web-приложение VK ID (OAuth с PKCE, без secret).
# Redirect URL для обоих: https://livsi.shop/auth/vk/callback.
VK_CLIENT_ID=
# Необязательно: точный адрес возврата, зарегистрированный в VK ID.
VK_REDIRECT_URI=

# Оповещения о сбоях в Телеграм.
#
# Бот пишет в рабочую группу с топиками. Токен выдаёт @BotFather;
# бота нужно добавить в группу — писать в чужие чаты он не может.
#
# Номер чата и номер топика берутся из ссылки на топик: в
# https://t.me/c/4404612976/4 чат — это 4404612976 с приставкой -100,
# то есть -1004404612976, а 4 — это номер топика.
#
# Пока канал telegram не добавлен в LOG_STACK, оповещения не уходят,
# даже если всё остальное заполнено.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ERRORS=
TELEGRAM_TOPIC_PAYMENTS=2
TELEGRAM_TOPIC_LEADS=13
TELEGRAM_TOPIC_STOCK=15
TELEGRAM_TOPIC_USERS=17
TELEGRAM_TOPIC_ISSUES=19
TELEGRAM_TOPIC_SHIPMENTS=113
SHIPMENTS_QUEUE_CONNECTION=database
# Оплаты отправляются через очередь независимо от LOG_STACK.
TELEGRAM_PAYMENTS_CONNECTION=database
# На боевом сервере обязательно v6 — IPv4 до api.telegram.org фильтруется.
TELEGRAM_IP_VERSION=
